!=======================================================================
!                                                                      !
!  Nemuro Lower Trophic Level Ecosystem Model.                         !
!                                                                      !
!  This routine computes the biological sources and sinks and adds     !
!  then the global biological fields. Currently, the ecosystem has     !
!  the following functional compartments:                              !
!                                                                      !
!    iSphy     small phytoplankton biomass, nanophytoplankton          !
!    iLphy     large phytoplankton biomass, diatoms                    !
!    iSzoo     small zooplankton biomass, microzooplankton (ciliates)  !
!    iLzoo     large zooplankton biomass, mesozooplankton (copepods)   !
!    iPzoo     predator zooplankton biomass (euphausiids, etc)         !
!    iNO3_     nitrate concentration, NO3                              !
!    iNH4_     ammonium concentration, NH4                             !
!    iPON_     particulate organic nitrogen                            !
!    iDON_     dissolved organic nitrogen                              !
!    iSiOH     silicate concentration, Si(OH)4 (silicic acid)          !
!    iopal     particulate organic silica                              !
!                                                                      !
!  Reference:                                                          !
!                                                                      !
!    Kishi, M. J., et  all, 2007: Nemuro - a lower trophic level       !
!      model for the North Pacific marine ecosystem,  Ecological       !
!      Modelling, 202, 12-25.                                          !
!    Fiechter, J., A.M. Moore, 2009: Interannual spring bloom          !
!      variability and Ekman pumping in the coastal Gulf of Alaska,    !
!      J. Geophys. Res., 114, C06004.                                  !
!    Fiechter, J., A.M. Moore, C.A. Edwards, K.W. Bruland,             !
!      E. Di Lorenzo, C.V.W. Lewis, T.M. Powell, E. Curchitser         !
!      and K. Hedstrom, 2009: Modeling iron limitation of primary      !
!      production in the coastal Gulf of Alaska, Deep Sea Res. II      !
!                                                                      !
!=======================================================================
!
      implicit none
!
      PRIVATE
      PUBLIC  :: biology
!
      CONTAINS
!
!***********************************************************************
      SUBROUTINE biology (ng,tile)
!***********************************************************************
!
      USE mod_param
      USE mod_forces
      USE mod_grid
      USE mod_ncparam
      USE mod_ocean
      USE mod_stepping
#if defined DIAGNOSTICS_BIO
      USE mod_diags
#endif
!
!  Imported variable declarations.
!
      integer, intent(in) :: ng, tile
!
!  Local variable declarations.
!
      character (len=*), parameter :: MyFile =                          &
     &  __FILE__
!
#include "tile.h"
!
!  Set header file name.
!
#ifdef DISTRIBUTE
      IF (Lbiofile(iNLM)) THEN
#else
      IF (Lbiofile(iNLM).and.(tile.eq.0)) THEN
#endif
        Lbiofile(iNLM)=.FALSE.
        BIONAME(iNLM)=MyFile
      END IF
!
#ifdef PROFILE
      CALL wclock_on (ng, iNLM, 15, __LINE__, MyFile)
#endif
      CALL nemuro_restruct_tile (ng, tile,                              &
     &                           LBi, UBi, LBj, UBj, N(ng), NT(ng),     &
     &                           IminS, ImaxS, JminS, JmaxS,            &
     &                           nstp(ng), nnew(ng),                    &
#ifdef MASKING
     &                           GRID(ng) % rmask,                      &
#endif
     &                           GRID(ng) % Hz,                         &
     &                           GRID(ng) % z_r,                        &
     &                           GRID(ng) % z_w,                        &
     &                           FORCES(ng) % srflx,                    &
#ifdef OAE
     &                           FORCES(ng) % OAEflux,                  &
#endif
#ifdef DOR
     &                           FORCES(ng) % DORflux,                  &
#endif
#ifdef DAILY_SHORTWAVE
     &                           FORCES(ng) % srflx_avg,                &
#endif
#if defined ATTSW_LIN
     &                           GRID(ng) % h  ,                        &
#endif
#if defined CARB || defined OXY
# ifdef BULK_FLUXES
     &                           FORCES(ng) % Uwind,                    &
     &                           FORCES(ng) % Vwind,                    &
# else
     &                           FORCES(ng) % sustr,                    &
     &                           FORCES(ng) % svstr,                    &
# endif
#endif
#ifdef CARB
     &                           OCEAN(ng) % pH,                        &
     &                           OCEAN(ng) % CO2flx,                    &
     &                           OCEAN(ng) % omega_arag,                &
     &                           OCEAN(ng) % CO2star,                   &
     &                           OCEAN(ng) % pCO2,                      &
#endif
#if defined ISO || defined ISO_13C
     &                           OCEAN(ng) % F13Cas,                   &
     &                           OCEAN(ng) % F13Csa,                   &
#endif
#if defined DIAGNOSTICS_BIO
     &                           DIAGS(ng) % DiaBio2d,                  &
     &                           DIAGS(ng) % DiaBio3d,                  &
#endif
     &                           OCEAN(ng) % t)

#ifdef PROFILE
      CALL wclock_off (ng, iNLM, 15, __LINE__, MyFile)
#endif
      RETURN
      END SUBROUTINE biology
!
!-----------------------------------------------------------------------
      SUBROUTINE nemuro_restruct_tile (ng, tile,                        &
     &                                 LBi, UBi, LBj, UBj, UBk, UBt,    &
     &                                 IminS, ImaxS, JminS, JmaxS,      &
     &                                 nstp, nnew,                      &
#ifdef MASKING
     &                                 rmask,                           &
#endif
     &                                 Hz, z_r, z_w,                    &
     &                                 srflx,                           &
#ifdef OAE
     &                                 OAEflux,                          &
#endif
#ifdef DOR
     &                                 DORflux,                         &
#endif
#ifdef DAILY_SHORTWAVE
     &                                 srflx_avg,                       &
#endif
#if defined ATTSW_LIN
     &                                 h,                               &
#endif
#if defined CARB || defined OXY
# ifdef BULK_FLUXES
     &                                 Uwind, Vwind,                    &
# else
     &                                 sustr, svstr,                    &
# endif
#endif
#ifdef CARB
     &                                 pH, CO2flx, omega_arag,          &
     &                                 CO2star, pCO2,                   &
# if defined ISO || defined ISO_13C
     &                                 F13Cas, F13Csa,                  &
# endif
#endif
#if defined DIAGNOSTICS_BIO
     &                                 DiaBio2d, DiaBio3d,              &
#endif
     &                                 t)
!-----------------------------------------------------------------------
!
      USE mod_param
      USE mod_biology
      USE mod_ncparam
      USE mod_scalars
      USE mod_nemuro_sms
!#if defined CARB
!      USE mod_biology, ONLY: pCO2_water
!#endif
!
!  Imported variable declarations.
!
      integer, intent(in) :: ng, tile
      integer, intent(in) :: LBi, UBi, LBj, UBj, UBk, UBt
      integer, intent(in) :: IminS, ImaxS, JminS, JmaxS
      integer, intent(in) :: nstp, nnew
#if defined ATTSW_LIN
      real(r8), intent(in) :: h(LBi:,LBj:)
#endif
#ifdef ASSUMED_SHAPE
# ifdef MASKING
      real(r8), intent(in) :: rmask(LBi:,LBj:)
# endif
      real(r8), intent(in) :: Hz(LBi:,LBj:,:)
      real(r8), intent(in) :: z_r(LBi:,LBj:,:)
      real(r8), intent(in) :: z_w(LBi:,LBj:,0:)
      real(r8), intent(in) :: srflx(LBi:,LBj:)
# ifdef OAE
	  real(r8), intent(in) :: OAEflux(LBi:,LBj:)
# endif
# ifdef DOR
	  real(r8), intent(in) :: DORflux(LBi:,LBj:)
# endif
# ifdef DAILY_SHORTWAVE
      real(r8), intent(in) :: srflx_avg(LBi:,LBj:)
# endif
# if defined CARB || defined OXY
#  ifdef BULK_FLUXES
      real(r8), intent(in) :: Uwind(LBi:,LBj:)
      real(r8), intent(in) :: Vwind(LBi:,LBj:)
#  else
      real(r8), intent(in) :: sustr(LBi:,LBj:)
      real(r8), intent(in) :: svstr(LBi:,LBj:)
#  endif
# endif
# ifdef CARB
      real(r8), intent(inout) :: pH(LBi:,LBj:,:)
      real(r8), intent(inout) :: CO2flx(LBi:,LBj:)
#  if defined ISO || defined ISO_13C
      real(r8), intent(inout) :: F13Cas(LBi:,LBj:)
      real(r8), intent(inout) :: F13Csa(LBi:,LBj:)
#  endif 
      real(r8), intent(inout) :: omega_arag(LBi:,LBj:,:)
      real(r8), intent(inout) :: CO2star(LBi:,LBj:,:)
      real(r8), intent(inout) :: pCO2(LBi:,LBj:,:)
# endif
# ifdef DIAGNOSTICS_BIO
      real(r8), intent(inout) :: DiaBio2d(LBi:,LBj:,:)
      real(r8), intent(inout) :: DiaBio3d(LBi:,LBj:,:,:)
# endif
      real(r8), intent(inout) :: t(LBi:,LBj:,:,:,:)
#else
# ifdef MASKING
      real(r8), intent(in) :: rmask(LBi:UBi,LBj:UBj)
# endif
      real(r8), intent(in) :: Hz(LBi:UBi,LBj:UBj,UBk)
      real(r8), intent(in) :: z_r(LBi:UBi,LBj:UBj,UBk)
      real(r8), intent(in) :: z_w(LBi:UBi,LBj:UBj,0:UBk)
      real(r8), intent(in) :: srflx(LBi:UBi,LBj:UBj)
# ifdef OAE
	  real(r8), intent(in) :: OAEflux(LBi:UBi,LBj:UBj)
# endif
# ifdef DOR
	  real(r8), intent(in) :: DORflux(LBi:UBi,LBj:UBj)
# endif
# ifdef DAILY_SHORTWAVE
      real(r8), intent(in) :: srflx_avg(LBi:UBi,LBj:UBj)
# endif
# if defined CARB || defined OXY
#  ifdef BULK_FLUXES
      real(r8), intent(in) :: Uwind(LBi:UBi,LBj:UBj)
      real(r8), intent(in) :: Vwind(LBi:UBi,LBj:UBj)
#  else
      real(r8), intent(in) :: sustr(LBi:UBi,LBj:UBj)
      real(r8), intent(in) :: svstr(LBi:UBi,LBj:UBj)
#  endif
# endif
# ifdef CARB
      real(r8), intent(inout) :: pH(LBi:UBi,LBj:UBj,UBk)
      real(r8), intent(inout) :: CO2flx(LBi:UBi,LBj:UBj)
#  if defined ISO || defined ISO_13C 
      real(r8), intent(inout) :: F13Cas(LBi:UBi,LBj:UBj) 
      real(r8), intent(inout) :: F13Csa(LBi:UBi,LBj:UBj) 
#  endif 
      real(r8), intent(inout) :: CO2star(LBi:UBi,LBj:UBj,UBk)
      real(r8), intent(inout) :: omega_arag(LBi:UBi,LBj:UBj,UBk)
      real(r8), intent(inout) :: pCO2(LBi:UBi,LBj:UBj,UBk)
# endif
# ifdef DIAGNOSTICS_BIO
      real(r8), intent(inout) :: DiaBio2d(LBi:UBi,LBj:UBj,NDbio2d)
      real(r8), intent(inout) :: DiaBio3d(LBi:UBi,LBj:UBj,UBk,NDbio3d)
# endif
      real(r8), intent(inout) :: t(LBi:UBi,LBj:UBj,UBk,3,UBt)
#endif
!
!  Local variable declarations.
!
      integer :: Iter, ibio, itrc
      integer :: i, j, k
      real(r8) :: dtdays, dz
      real(r8) :: cff
#ifdef CONSERVATION
      real(r8) :: delta_dissolved = 0
      real(r8) :: delta_alk = 0

#endif
#ifdef CARB
      real(r8) :: cffC
# ifdef MASKING
      real(r8) :: maskik
# endif
#endif

      real(r8), dimension(IminS:ImaxS) :: PARsur

      real(r8), dimension(NT(ng),2) :: BioTrc

      real(r8), dimension(IminS:ImaxS,N(ng),NT(ng)) :: Bio
      real(r8), dimension(IminS:ImaxS,N(ng),NT(ng)) :: Bio_old

      real(r8), dimension(IminS:ImaxS,N(ng)) :: Hz_inv
      real(r8), dimension(IminS:ImaxS,N(ng)) :: Hz_inv2
      real(r8), dimension(IminS:ImaxS,N(ng)) :: Hz_inv3
#if defined NEM_IRON_LIMIT 
# ifdef NEM_IRON_RELAX
      real(r8) :: FeNudgCoef
# endif
# ifdef NEM_IRON_RSIN
      real(r8), dimension(IminS:ImaxS,N(ng)) :: LPSiN
      real(r8) :: FNratio, FCratio, FCratioE, Flimit
      !real(r8) :: cffFe
      !real(r8), parameter :: Fe_min = 0.05_r8
      !real(r8), parameter :: Fe_max = 2.0_r8
      real(r8), parameter :: SiN_min = 1.0_r8
      real(r8), parameter :: SiN_max = 3.0_r8
      real(r8), parameter :: MinVal = 1.0e-6_r8
# endif
#endif
#if defined NEMURO_CHL_GEIDER || defined NEMURO_CHL_NUDGECHL2N
      real(r8), dimension(IminS:ImaxS,N(ng)) :: Chl2NS,Chl2NL
      real(r8), dimension(IminS:ImaxS,N(ng)) :: LightChl
# if defined NEMURO_CHL_GEIDER
      real(r8), dimension(IminS:ImaxS,N(ng)) :: BSS,BSL
# endif
#endif
      real(r8), dimension(IminS:ImaxS,N(ng)) :: LightL
      real(r8), dimension(IminS:ImaxS,N(ng)) :: LightS
# ifdef DIAGNOSTICS_BIO
      real(r8), dimension(IminS:ImaxS,NDbio2d) :: DiaBio2dJ
      real(r8), dimension(IminS:ImaxS,N(ng),NDbio3d) :: DiaBio3dJ
      integer :: ivar
# endif

#include "set_bounds.h"
#if defined DIAGNOSTICS_BIO
!
!-----------------------------------------------------------------------
! If appropriate, initialize time-averaged diagnostic arrays.
!-----------------------------------------------------------------------
!
      IF (((iic(ng).gt.ntsDIA(ng)).and.                                 &
     &     (MOD(iic(ng),nDIA(ng)).eq.1)).or.                            &
     &    ((iic(ng).ge.ntsDIA(ng)).and.(nDIA(ng).eq.1)).or.             &
     &    ((nrrec(ng).gt.0).and.(iic(ng).eq.ntstart(ng)))) THEN
        DO ivar=1,NDbio2d
          DO j=Jstr,Jend
            DO i=Istr,Iend
              DiaBio2d(i,j,ivar)=0.0_r8
            END DO
          END DO
        END DO
        DO ivar=1,NDbio3d
          DO k=1,N(ng)
            DO j=Jstr,Jend
              DO i=Istr,Iend
                DiaBio3d(i,j,k,ivar)=0.0_r8
              END DO
            END DO
          END DO
        END DO
      END IF
#endif
!
!-----------------------------------------------------------------------
!  Add biological Source/Sink terms.
!-----------------------------------------------------------------------
!
!  Avoid computing source/sink terms if no biological iterations.
!
      IF (BioIter(ng).le.0) RETURN
!!!
!!!  Set time-stepping size (days) according to the number of iterations.
!!!
!!      dtdays=dt(ng)*sec2day/REAL(BioIter(ng),r8)
!!!
!!!  Set vertical sinking indentification vector.
!!!
!!      idsink(1)=iPON_                 ! particulate organic nitrogen
!!      idsink(2)=iopal                 ! particulate organic silica
!!#if defined CARB & ! defined KO_CAR_NLMB_SINK
!!      idsink(3)=iCalC                 ! carbon detritus
!!#endif
!!!
!!!  Set vertical sinking velocity vector in the same order as the
!!!  identification vector, IDSINK.
!!!
!!      Wbio(1)=setVPON(ng)             ! particulate organic nitrogen
!!      Wbio(2)=setVOpal(ng)            ! particulate organic silica
!!#if defined CARB & ! defined KO_CAR_NLMB_SINK
!!      Wbio(3)=setVPON(ng)             ! carbon detritus
!!#endif
!
!  Compute inverse thickness to avoid repeated divisions.
!
      J_LOOP : DO j=Jstr,Jend
        DO k=1,N(ng)
          DO i=Istr,Iend
            Hz_inv(i,k)=1.0_r8/Hz(i,j,k)
          END DO
        END DO
        DO k=1,N(ng)-1
          DO i=Istr,Iend
            Hz_inv2(i,k)=1.0_r8/(Hz(i,j,k)+Hz(i,j,k+1))
          END DO
        END DO
        DO k=2,N(ng)-1
          DO i=Istr,Iend
            Hz_inv3(i,k)=1.0_r8/(Hz(i,j,k-1)+Hz(i,j,k)+Hz(i,j,k+1))
          END DO
        END DO
!
!  Extract biological variables from tracer arrays, place them into
!  scratch arrays, and restrict their values to be positive definite.
!  At input, all tracers (index nnew) from predictor step have
!  transport units (m Tunits) since we do not have yet the new
!  values for zeta and Hz. These are known after the 2D barotropic
!  time-stepping.
!
        DO itrc=1,NBT
          ibio=idbio(itrc)
          DO k=1,N(ng)
            DO i=Istr,Iend
# ifdef MASKING
              IF (rmask(i,j).EQ.1) THEN
# endif

# ifdef NEG_ALERT
               IF ((ibio.NE.12) .AND. (ibio.NE.13) .AND. (ibio.NE.33)) THEN
                IF (t(i,j,k,nstp,ibio).LE.0.0_r8) THEN
                  print *, "before nemuro nstp i,j,k,ibio(eq to tracer#),val=", i,j,k,ibio,t(i,j,k,nstp,ibio)
                ENDIF
                IF (t(i,j,k,nstp,ibio).LE.0.0_r8) THEN
                  print *, "negative alert!"
                ENDIF
               ENDIF
               IF ((ibio.NE.12) .AND. (ibio.NE.13) .AND. (ibio.NE.33)) THEN
                IF (t(i,j,k,nnew,ibio).LE.0.0_r8) THEN
                  print *, "before nemuro nnew i,j,k,ibio(eq to tracer#),val=", i,j,k,ibio,t(i,j,k,nnew,ibio)
                ENDIF
                IF (t(i,j,k,nnew,ibio).LE.0.0_r8) THEN
                  print *, "negative alert!"
                ENDIF
               ENDIF
# endif
               Bio_old(i,k,ibio)=MAX(0.0_r8,t(i,j,k,nstp,ibio))
               Bio(i,k,ibio)=Bio_old(i,k,ibio)
# ifdef MASKING
              ENDIF
# endif
            END DO
          END DO
        END DO
# ifdef DIAGNOSTICS_BIO
!  
!  Initialize local (J-slice) diagnostic variables 
!  
        DO ivar=1,NDbio2d
          DO i=Istr,Iend
            DiaBio2dJ(i,ivar)=0.0_r8
          END DO
        END DO
        DO ivar=1,NDbio3d
          DO k=1,N(ng)
            DO i=Istr,Iend
              DiaBio3dJ(i,k,ivar)=0.0_r8
            END DO
          END DO
        END DO
# endif
! TODO merge this with above
#ifdef CARB
!! TODO how important are the limits?
!        DO k=1,N(ng)
!          DO i=Istr,Iend
!            Bio_old(i,k,iTIC_)=MAX(t(i,j,k,nstp,iTIC_),0.0_r8)
!            Bio_old(i,k,iTAlk)=MAX(t(i,j,k,nstp,iTAlk),0.0_r8)
!            Bio_old(i,k,iCalC)=MAX(t(i,j,k,nstp,iCalC),0.0_r8)
!            Bio_old(i,k,iTIC_)=MIN(Bio_old(i,k,iTIC_),3000.0_r8)
!            Bio_old(i,k,iTIC_)=MAX(Bio_old(i,k,iTIC_),400.0_r8)
!            Bio(i,k,iTIC_)=Bio_old(i,k,iTIC_)
!            Bio(i,k,iTAlk)=Bio_old(i,k,iTAlk)
!            Bio(i,k,iCalC)=Bio_old(i,k,iCalC)
!          END DO
!        END DO
#endif
!
!  Extract potential temperature and salinity.
!
        DO k=1,N(ng)
          DO i=Istr,Iend
            Bio(i,k,itemp)=t(i,j,k,nstp,itemp)
#if defined OXY || defined CARB
! TODO Jerome added this, keep?
!           Bio(i,k,itemp)=MIN(t(i,j,k,nstp,itemp),35.0_r8)
            Bio(i,k,isalt)=t(i,j,k,nstp,isalt)
#endif
          END DO
        END DO
#if defined NEMURO_CHL && defined LOGDIAGNOSTICS_NEM_CHL
        IF (j==LOGDIAGNOSTICS_NEM_CHL_J.and.LOGDIAGNOSTICS_NEM_CHL_I.ge.Istr.and.LOGDIAGNOSTICS_NEM_CHL_I.le.Iend) THEN
          i=LOGDIAGNOSTICS_NEM_CHL_I
          k=LOGDIAGNOSTICS_NEM_CHL_K
          write(*,'(2a,3(i0,a))') 'LOGDIAGNOSTICS_NEM_CHL',             &
     &      ' reporting values at (',i,',',j,',',k,')'
          write(*,'(a30,f19.12)') 'initial Sphy = ',Bio(i,k,iSphy)
# if ! defined NEMURO_CHL_STATICRATIO
          write(*,'(a30,f19.12)') 'initial ChlS = ',Bio(i,k,iChlS)
# endif
          write(*,'(a30,f19.12)') 'initial Lphy = ',Bio(i,k,iLphy)
# if ! defined NEMURO_CHL_STATICRATIO
          write(*,'(a30,f19.12)') 'initial ChlL = ',Bio(i,k,iChlL)
# endif
          write(*,'(a30,f19.12)') 'initial Chlo = ',Bio(i,k,iChlo)
# if ! defined NEMURO_CHL_STATICRATIO
          if (Bio(i,k,iChlo).lt.Bio(i,k,iChlS)) then
            write(*,'(a30,f19.12)') '!!! Chlo - ChlS = ',               &
     &        Bio(i,k,iChlo) - Bio(i,k,iChlS)
          end if
# endif
        END IF
#endif
!
!  Calculate surface Photosynthetically Available Radiation (PAR).  The
!  net shortwave radiation is scaled back to Watts/m2 and multiplied by
!  the fraction that is photosynthetically available, PARfrac.
!
        DO i=Istr,Iend
#if defined LET_THERE_BE_LIGHT
          PARsur(i)=100.0_r8
#else
# if defined DAILY_SHORTWAVE
!  srflx_avg is used only for biology and is not rescaled
!  by rho0*Cp on input in inp_par.F.
!  It does not need to be rescaled back to W/m2 here.
          PARsur(i)=PARfrac(ng)*srflx_avg(i,j)
# else
          PARsur(i)=PARfrac(ng)*srflx(i,j)*rho0*Cp
# endif
#endif
        END DO
#if defined NEM_IRON_LIMIT && defined NEM_IRON_RELAX
! CAE not sure if this code block should go into a subroutine or not.
!
!  Set nudging coefficient for dissolved iron over the shelf.
!
      FeNudgCoef=dt(ng)/(FeNudgTime(ng)*86400.0_r8)
!
!  Relax dissolved iron at coast (h <= FeHim) to a constant value
!  (FeMax) over a time scale (FeNudgTime; days) to simulate sources
!  at the shelf. Use -z_w(i,j,0) for h(i,j).
!
        DO k=1,N(ng)
          DO i=Istr,Iend
            IF (-z_w(i,j,0).le.FeHmin(ng)) THEN
              Bio(i,k,iFeD_)=Bio(i,k,iFeD_)+                            &
     &                       FeNudgCoef*(FeMax(ng)-Bio(i,k,iFeD_))
            END IF
          END DO
        END DO
#endif
#if defined NEM_IRON_LIMIT && defined NEM_IRON_RSIN
!
!  Variable Si:N ratio for dimatoms based on dissolved iron concentration
!  Si:N varies between 1:1 (high iron) and 3:1 (low iron)
        DO k=1,N(ng)
          DO i=Istr,Iend
            !Fe_min = 0.05_r8
            !Fe_max = 2.0_r8
            !SiN_min = 1.0_r8
            !SiN_max = 3.0_r8
