              IF (rmask(i,j).EQ.1) THEN
#endif
                cff=Bio(i,k,ibio)-Bio_old(i,k,ibio)
!#ifdef NEG_ALERT
!                IF ((i.EQ.88) .AND. (j.EQ.124) .AND. (k.EQ.14) .AND. (ibio.EQ.4)) THEN
!                  print *, "Diatom:"
!                  print *, "Bio(i,k,ibio), Bio_old(i,k,ibio)", Bio(i,k,ibio), Bio_old(i,k,ibio)
!                  print *, "cff (Bio(i,k,ibio)-Bio_old(i,k,ibio)), Hz(i,j,k)",cff, Hz(i,j,k)
!                  print *, "t(i,j,k,nnew,ibio) before", t(i,j,k,nnew,ibio)
!                  print *, "new t(i,j,k,nnew,ibio)",t(i,j,k,nnew,ibio)+cff*Hz(i,j,k) 
!                ENDIF
!                IF ((i.EQ.88) .AND. (j.EQ.124) .AND. (k.EQ.14) .AND. (ibio.EQ.15)) THEN
!                  print *, "Diatom15:"
!                  print *, "Bio(i,k,ibio), Bio_old(i,k,ibio)", Bio(i,k,ibio), Bio_old(i,k,ibio)
!                  print *, "cff (Bio(i,k,ibio)-Bio_old(i,k,ibio)), Hz(i,j,k)",cff, Hz(i,j,k)
!                  print *, "t(i,j,k,nnew,ibio) before", t(i,j,k,nnew,ibio)
!                  print *, "new t(i,j,k,nnew,ibio)",t(i,j,k,nnew,ibio)+cff*Hz(i,j,k)
!                ENDIF
!                IF ((i.EQ.88) .AND. (j.EQ.124) .AND. (k.EQ.14) .AND. (ibio.EQ.24)) THEN
!                  print *, "Diatom14:"
!                  print *, "Bio(i,k,ibio), Bio_old(i,k,ibio)", Bio(i,k,ibio), Bio_old(i,k,ibio)
!                  print *, "cff (Bio(i,k,ibio)-Bio_old(i,k,ibio)), Hz(i,j,k)",cff, Hz(i,j,k)
!                  print *, "t(i,j,k,nnew,ibio) before", t(i,j,k,nnew,ibio)
!                  print *, "new t(i,j,k,nnew,ibio)",t(i,j,k,nnew,ibio)+cff*Hz(i,j,k)
!                ENDIF
!#endif

                t(i,j,k,nnew,ibio)=t(i,j,k,nnew,ibio)+cff*Hz(i,j,k)

#ifdef NEG_ALERT
                IF ((ibio.NE.12) .AND. (ibio.NE.13) .AND. (ibio.NE.33)) THEN
                 IF ((Bio(i,k,ibio).LE.0.0_r8) .OR. (Bio(i,k,ibio).NE.Bio(i,k,ibio))) THEN
                   print *, "after nemuro in Bio i,j,k,ibio (eq to tracer #),val=", i,j,k,ibio,Bio(i,k,ibio)
                 ENDIF
                 IF ((Bio(i,k,ibio).LE.0.0_r8) .OR. (Bio(i,k,ibio).NE.Bio(i,k,ibio))) THEN
                   print *, "negative alert! or NaN"
                 ENDIF
                 IF ((t(i,j,k,nnew,ibio).LE.0.0_r8) .OR. (t(i,j,k,nnew,ibio).NE.t(i,j,k,nnew,ibio))) THEN
                   print *, "after nemuro in nnew i,j,k,ibio(eq to tracer #),val=", i,j,k,ibio,t(i,j,k,nnew,ibio)
                 ENDIF
                 IF ((t(i,j,k,nnew,ibio).LE.0.0_r8) .OR. (t(i,j,k,nnew,ibio).NE.t(i,j,k,nnew,ibio))) THEN
                   print *, "negative alert! or NaN"
                 ENDIF
                ENDIF
#endif

#ifdef MASKING
              END IF
#endif
            END DO
          END DO
        END DO
#if defined DIAGNOSTICS_BIO
!
!       Update DiaBio variables with local (J-slice) values
!
        DO ivar=1,NDbio2d
     &                          , j                                     &
          DO i=Istr,Iend
            DiaBio2d(i,j,ivar)=DiaBio2d(i,j,ivar) +                     &
     &                         DiaBio2dJ(i,ivar)
          END DO
        END DO
        DO ivar=1,NDbio3d
          DO k=1,N(ng)
            DO i=Istr,Iend
              DiaBio3d(i,j,k,ivar)=DiaBio3d(i,j,k,ivar) +               &
     &                             DiaBio3dJ(i,k,ivar)
!              IF (DiaBio3dJ(i,k,ivar) .GT. diamax1) THEN
!                diamax1=DiaBio3d(i,j,k,ivar)
!              END IF 
!              IF (DiaBio3d(i,j,k,ivar) .GT. diamax2) THEN
!                diamax2=DiaBio3d(i,j,k,ivar)
!              END IF 
            END DO
          END DO
!          print *, ivar,': max(diaJ)=',diamax1
!          print *, ivar,': max(dia3d)=',diamax2
        END DO
#endif
#if defined NEMURO_CHL && defined LOGDIAGNOSTICS_NEM_CHL && ! defined NEMURO_CHL_STATICRATIO
        IF (j==LOGDIAGNOSTICS_NEM_CHL_J.and.LOGDIAGNOSTICS_NEM_CHL_I.ge.Istr.and.LOGDIAGNOSTICS_NEM_CHL_I.le.Iend) THEN
          i=LOGDIAGNOSTICS_NEM_CHL_I
          k=LOGDIAGNOSTICS_NEM_CHL_K
          write(*,'(a30,f19.12)') 'final ChlS = ',Bio(i,k,iChlS)
          write(*,'(a30,f19.12)') 'final ChlL = ',Bio(i,k,iChlL)
          write(*,'(a30,f19.12)') 'final ChlS below = ',Bio(i,k-1,iChlS)
          write(*,'(a30,f19.12)') 'final ChlL below = ',Bio(i,k-1,iChlL)
        END IF
#endif

      END DO J_LOOP
      
      RETURN
      END SUBROUTINE nemuro_restruct_tile

