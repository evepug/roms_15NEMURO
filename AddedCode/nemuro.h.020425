      MODULE biology_mod
!
!git $Id$
!================================================== Hernan G. Arango ===
!  Copyright (c) 2002-2025 The ROMS Group                              !
!    Licensed under a MIT/X style license                              !
!    See License_ROMS.md                                               !
!=======================================================================
!                                                                      !
!  Nemuro Lower Trophic Level Ecosystem Model.                         !
!                                                                      !
!  This routine computes the biological sources and sinks and adds     !
!  then the global biological fields. Currently, the ecosystem has     !
!  the following functional compartments:                              !
!                                                                      !
!    iSphy     small phytoplankton biomass, nanophytoplankton          !
!    iLphy     large phytoplankton biomass, diatoms                    !
!    iSzoo     small zooplankton biomass, microzooplankton (ciliates)  !
!    iLzoo     large zooplankton biomass, mesozooplankton (copepods)   !
!    iPzoo     predator zooplankton biomass (euphausiids, etc)         !
!    iNO3_     nitrate concentration, NO3                              !
!    iNH4_     ammonium concentration, NH4                             !
!    iPON_     particulate organic nitrogen                            !
!    iDON_     dissolved organic nitrogen                              !
!    iSiOH     silicate concentration, Si(OH)4 (silicic acid)          !
!    iopal     particulate organic silica                              !
!                                                                      !
!  Reference:                                                          !
!                                                                      !
!    Kishi, M. J., et  all, 2007: Nemuro - a lower trophic level       !
!      model for the North Pacific marine ecosystem,  Ecological       !
!      Modelling, 202, 12-25.                                          !
!                                                                      !
!=======================================================================
!
      implicit none
!
      PRIVATE
      PUBLIC  :: biology
!
      CONTAINS
!
!***********************************************************************
      SUBROUTINE biology (ng,tile)
!***********************************************************************
!
      USE mod_param
      USE mod_forces
      USE mod_grid
      USE mod_ncparam
      USE mod_ocean
      USE mod_stepping
!
!  Imported variable declarations.
!
      integer, intent(in) :: ng, tile
!
!  Local variable declarations.
!
      character (len=*), parameter :: MyFile =                          &
     &  __FILE__
!
#include "tile.h"
!
!  Set header file name.
!
#ifdef DISTRIBUTE
      IF (Lbiofile(iNLM)) THEN
#else
      IF (Lbiofile(iNLM).and.(tile.eq.0)) THEN
#endif
        Lbiofile(iNLM)=.FALSE.
        BIONAME(iNLM)=MyFile
      END IF
!
#ifdef PROFILE
      CALL wclock_on (ng, iNLM, 15, __LINE__, MyFile)
#endif
      CALL nemuro_tile (ng, tile,                                      &
     &                  LBi, UBi, LBj, UBj, N(ng), NT(ng),             &
     &                  IminS, ImaxS, JminS, JmaxS,                    &
     &                  nstp(ng), nnew(ng),                            &
#ifdef MASKING
     &                   GRID(ng) % rmask,                              &
#endif
     &                   GRID(ng) % Hz,                                 &
     &                   GRID(ng) % z_r,                                &
     &                   GRID(ng) % z_w,                                &
#if defined ATTSW_LIN
     &                   GRID(ng) % h  ,                                &
#endif
     &                   FORCES(ng) % srflx,                            &
#if defined CARB || defined OXY
# ifdef BULK_FLUXES
     &                   FORCES(ng) % Uwind,                            &
     &                   FORCES(ng) % Vwind,                            &
# else
     &                   FORCES(ng) % sustr,                            &
     &                   FORCES(ng) % svstr,                            &
# endif
#endif
#ifdef CARB
     &                   OCEAN(ng) % pH,                                &
     &                   OCEAN(ng) % CO2flx,                            &
     &                   OCEAN(ng) % pCO2,                              &
#endif
     &                   OCEAN(ng) % t)

#ifdef PROFILE
      CALL wclock_off (ng, iNLM, 15, __LINE__, MyFile)
#endif
!
      RETURN
      END SUBROUTINE biology
!
!-----------------------------------------------------------------------
      SUBROUTINE nemuro_tile (ng, tile,                                 &
     &                        LBi, UBi, LBj, UBj, UBk, UBt,             &
     &                        IminS, ImaxS, JminS, JmaxS,               &
     &                        nstp, nnew,                               &
#ifdef MASKING
     &                         rmask,                                   &
#endif
     &                         Hz, z_r, z_w,                            &
#if defined ATTSW_LIN
     &                         h,                                       &
#endif
     &                         srflx,                                   &
#if defined CARB || defined OXY
# ifdef BULK_FLUXES
     &                         Uwind, Vwind,                            &
# else
     &                         sustr, svstr,                            &
# endif
#endif
#ifdef CARB
     &                         pH, CO2flx, pCO2,                        &
#endif

     &                         t)
!-----------------------------------------------------------------------
!
      USE mod_param
      USE mod_biology
      USE mod_ncparam
      USE mod_scalars
#if defined CARB
      USE mod_biology, ONLY: pCO2_water
#endif

!
!  Imported variable declarations.
!
      integer, intent(in) :: ng, tile
      integer, intent(in) :: LBi, UBi, LBj, UBj, UBk, UBt
      integer, intent(in) :: IminS, ImaxS, JminS, JmaxS
      integer, intent(in) :: nstp, nnew
#if defined ATTSW_LIN
      real(r8), intent(in) :: h(LBi:,LBj:)
#endif
#ifdef ASSUMED_SHAPE
# ifdef MASKING
      real(r8), intent(in) :: rmask(LBi:,LBj:)
# endif
      real(r8), intent(in) :: Hz(LBi:,LBj:,:)
      real(r8), intent(in) :: z_r(LBi:,LBj:,:)
      real(r8), intent(in) :: z_w(LBi:,LBj:,0:)
      real(r8), intent(in) :: srflx(LBi:,LBj:)
# if defined CARB || defined OXY
#  ifdef BULK_FLUXES
      real(r8), intent(in) :: Uwind(LBi:,LBj:)
      real(r8), intent(in) :: Vwind(LBi:,LBj:)
#  else
      real(r8), intent(in) :: sustr(LBi:,LBj:)
      real(r8), intent(in) :: svstr(LBi:,LBj:)
#  endif
# endif
# ifdef CARB
      real(r8), intent(inout) :: pH(LBi:,LBj:,:)
      real(r8), intent(inout) :: CO2flx(LBi:,LBj:)
      real(r8), intent(inout) :: pCO2(LBi:,LBj:,:)
# endif
      real(r8), intent(inout) :: t(LBi:,LBj:,:,:,:)
#else
# ifdef MASKING
      real(r8), intent(in) :: rmask(LBi:UBi,LBj:UBj)
# endif
      real(r8), intent(in) :: Hz(LBi:UBi,LBj:UBj,UBk)
      real(r8), intent(in) :: z_r(LBi:UBi,LBj:UBj,UBk)
      real(r8), intent(in) :: z_w(LBi:UBi,LBj:UBj,0:UBk)
      real(r8), intent(in) :: srflx(LBi:UBi,LBj:UBj)
# if defined CARB || defined OXY
#  ifdef BULK_FLUXES
      real(r8), intent(in) :: Uwind(LBi:UBi,LBj:UBj)
      real(r8), intent(in) :: Vwind(LBi:UBi,LBj:UBj)
#  else
      real(r8), intent(in) :: sustr(LBi:UBi,LBj:UBj)
      real(r8), intent(in) :: svstr(LBi:UBi,LBj:UBj)
#  endif
# endif
# ifdef CARB
      real(r8), intent(inout) :: pH(LBi:UBi,LBj:UBj,UBk)
      real(r8), intent(inout) :: CO2flx(LBi:UBi,LBj:UBj)
      real(r8), intent(inout) :: pCO2(LBi:UBi,LBj:UBj,UBk)
# endif
      real(r8), intent(inout) :: t(LBi:UBi,LBj:UBj,UBk,3,UBt)
#endif
!
!  Local variable declarations.
!
#ifdef N15
# ifdef SINK_RATIO
      integer, parameter :: Nsink = 3
# else
      integer, parameter :: Nsink = 4
# endif
#else
      integer, parameter :: Nsink = 2
#endif
      integer :: Iter, ibio, indx, isink, itime, itrc, iTrcMax
      integer :: i, j, k, ks

      integer, dimension(Nsink) :: idsink

      real(r8), parameter :: MinVal = 1.0e-6_r8
#if defined NEMUCSC
      real(r8) :: Att, Irr, kappa
#else
      real(r8) :: AttL, AttS, IrrL, IrrS, KappaL, KappaS
#endif
#if defined ATTSW_LIN
      real(r8) :: AttSW_new
      real(r8), parameter :: Att_slope = -2.22e-5_r8
      real(r8), parameter :: Att_int = 0.0844_r8
#endif
      real(r8) :: dtdays, dz
      real(r8) :: GppAPS, GppAPL, GppNPS, GppNPL, GppPS, GppPL
      real(r8) :: GraPL2ZL, GraPL2ZP, GraPS2ZL, GraPS2ZS
      real(r8) :: GraZL2ZP, GraZS2ZL, GraZS2ZP
#if defined NEMUCSC
      real(r8) :: GraPL2ZS
#endif
      real(r8) :: EgeZL, EgeZP, EgeZS
      real(r8) :: ExcPL, ExcPS, ExcZL, ExcZP, ExcZS
      real(r8) :: MorPL, MorPS
# if defined OXY
#  if defined DENIT
      real(r8) :: DenitPON, DenitDON
#  endif
# endif

#if defined NEM_SPONGE
      integer :: nbfr
      real(r8) :: nemfac
      real(r8), dimension(IminS:ImaxS) :: mortfac
#endif
      real(r8) :: ResPL, ResPS
      real(r8) :: RnewL, RnewS
      real(r8) :: cff, cff1, cff2, cff3, cff4, cff5, cff6, cff7
#if defined CARB
      real(r8) :: cffC,u10squ
      real(r8) :: CO2_Flux, CO2_sol, SchmidtN, TempK
      real(r8) :: tempik, saltik, ticik, talkik, phik, pco2ik
# if defined NEMURO_CO2_SECULAR
      real(r8) :: pCO2air_secular
# endif

!   include this?
# ifdef MASKING
      real(r8) :: maskik
# endif
!   ?
#endif
#if defined OXY
!
! parameters for NEMURO oxygen model
!
      real(r8), parameter :: OA0 = 2.00907_r8       ! Oxygen
      real(r8), parameter :: OA1 = 3.22014_r8       ! saturation
      real(r8), parameter :: OA2 = 4.05010_r8       ! coefficients
      real(r8), parameter :: OA3 = 4.94457_r8
      real(r8), parameter :: OA4 =-0.256847_r8
      real(r8), parameter :: OA5 = 3.88767_r8
      real(r8), parameter :: OB0 =-0.00624523_r8
      real(r8), parameter :: OB1 =-0.00737614_r8
      real(r8), parameter :: OB2 =-0.0103410_r8
      real(r8), parameter :: OB3 =-0.00817083_r8
      real(r8), parameter :: OC0 =-0.000000488682_r8
      real(r8), parameter :: rOxNO3= 8.625_r8       ! 138/16
      real(r8), parameter :: rOxNH4= 6.625_r8       ! 106/16
# if defined DENIT
! where did this number come from?
! we want to know what the ratio of NO3 lost to
! NH4 created in denitrification is. To find it, we 
! can take the ratio of C lost to NH4 created by remineralization 
! (using redfield ratio C:N of 106/16=6.625), and divide it by the ratio
! of C lost to NO3 lost in denitrification (using value of 0.8 from 
! PISCES model). 
      real(r8), parameter :: rNO3NH4= 8.3_r8      ! ratio of NO3 used to NH4 created 
# endif
      real(r8), parameter :: l2mol = 1000.0_r8/22.3916_r8      ! from ml/l to umol/l (=mmol/m3)
      real(r8) :: u10squ, SchmidtN_Ox, O2satu, O2_Flux
      real(r8) :: TS, AA
#endif
#if defined CARB
!
!Parameters for NEMURO carbon model
!
      real(r8), parameter :: Acoef = 2073.1_r8      ! Schmidt
      real(r8), parameter :: Bcoef = 125.62_r8      ! number
      real(r8), parameter :: Ccoef = 3.6276_r8      ! transfer
      real(r8), parameter :: Dcoef = 0.043219_r8    ! coefficients
      real(r8), parameter :: A1 = -60.2409_r8       ! surface
      real(r8), parameter :: A2 = 93.4517_r8        ! CO2
      real(r8), parameter :: A3 = 23.3585_r8        ! solubility
      real(r8), parameter :: B1 = 0.023517_r8       ! coefficients
      real(r8), parameter :: B2 = -0.023656_r8
      real(r8), parameter :: B3 = 0.0047036_r8
# if defined NEMURO_CO2_TREND
      real(r8), parameter, dimension(12) :: pCO2air_mo =                &
     &    (/ 0.05_r8, 0.67_r8, 1.45_r8, 2.59_r8, 3.03_r8, 2.32_r8,      &
     &       0.72_r8,-1.45_r8,-3.13_r8,-3.24_r8,-2.07_r8,-0.90_r8 /)
# endif
#endif

!search should this be included?
!No: these are already defined in ROMS/Modules/mod_scalars.F
!      integer, parameter :: itemp = 1 !search should this be included?
!      integer, parameter :: isalt = 2
!go looking to understand where/if tracer #s were defined for temp/salt
!search
      real(r8) :: fac, fac1, fac2, fac3, fac4, fac5, fac6, fac7
#if defined NEMUCSC
      real(r8) :: fac8
#endif
      real(r8) :: cffL, cffR, cu, dltL, dltR

      real(r8), dimension(Nsink) :: Wbio

      integer, dimension(IminS:ImaxS,N(ng)) :: ksource

      real(r8), dimension(IminS:ImaxS) :: PARsur

      real(r8), dimension(NT(ng),2) :: BioTrc

      real(r8), dimension(IminS:ImaxS,N(ng),NT(ng)) :: Bio
      real(r8), dimension(IminS:ImaxS,N(ng),NT(ng)) :: Bio_old

      real(r8), dimension(IminS:ImaxS,0:N(ng)) :: FC

      real(r8), dimension(IminS:ImaxS,N(ng)) :: Hz_inv
      real(r8), dimension(IminS:ImaxS,N(ng)) :: Hz_inv2
      real(r8), dimension(IminS:ImaxS,N(ng)) :: Hz_inv3
      real(r8), dimension(IminS:ImaxS,N(ng)) :: LightL
      real(r8), dimension(IminS:ImaxS,N(ng)) :: LightS
      real(r8), dimension(IminS:ImaxS,N(ng)) :: WL
      real(r8), dimension(IminS:ImaxS,N(ng)) :: WR
      real(r8), dimension(IminS:ImaxS,N(ng)) :: bL
      real(r8), dimension(IminS:ImaxS,N(ng)) :: bR
      real(r8), dimension(IminS:ImaxS,N(ng)) :: qc

#ifdef N15
      real(r8) :: MorZS, MorZL, MorZP
      real(r8) :: nitrif, remin, decomp, reminDON
      real(r8) :: GppAPS15, GppAPL15, GppNPS15 
      real(r8) :: GppNPL15, GppPS15, GppPL15 
      real(r8) :: GraPL2ZL15, GraPL2ZP15, GraPS2ZL15, GraPS2ZS15
      real(r8) :: GraZL2ZP15, GraZS2ZL15, GraZS2ZP15
# if defined NEMUCSC
      real(r8) :: GraPL2ZS15
# endif      
      real(r8) :: EgeZL15, EgeZP15, EgeZS15
      real(r8) :: ExcPL15, ExcPS15, ExcZL15, ExcZP15, ExcZS15
      real(r8) :: MorPL15, MorPS15
      real(r8) :: MorZS15, MorZL15, MorZP15
      real(r8) :: ResPL15, ResPS15
      real(r8) :: RnewL15, RnewS15
      real(r8) :: nitrif15, remin15, decomp15, reminDON15
      real(r8) :: cff_iso1,cff_iso2, cff_iso3, cff_iso4, cff_iso5
      real(r8) :: cff_iso6, cff_iso7, cff_iso8, cff_iso9, cff_iso10
      real(r8) :: epsilon_NH4,epsilon_NO3,epsilon_nitrif
      real(r8) :: epsilon_remin,epsilon_decomp,epsilon_reminDON
      real(r8) :: gamma_NH4,gamma_NO3,gamma_exc, gamma_nitrif
      real(r8) :: gamma_remin,gamma_decomp,gamma_reminDON
# if defined OXY
#  if defined DENIT
      real(r8) :: gamma_denitPON, DenitPON15
      real(r8) :: gamma_denitDON, DenitDON15
#  endif
# endif
#endif

#ifdef N15_LIM
      real(r8), parameter :: Rstd = 1.0_r8
      real(r8), parameter :: t_d15N = 6.0_r8
      real(r8), parameter :: min_d15N = -10.0_r8
      real(r8), parameter :: max_d15N = 30.0_r8
      real(r8), parameter :: low_d15N = 3.0_r8
      real(r8), parameter :: high_d15N = 25.0_r8
      real(r8) :: d15N
#endif

#ifdef N15_CHECKS_BIOTOY
      real(r8) :: d15N
      real(r8) :: d15N_old
      real(r8) :: d15N_change
      real(r8) :: Szoo_old
      real(r8) :: Szoo_change
      real(r8) :: PON_change
      real(r8), parameter :: Rstd = 1.0_r8
#endif

#ifdef NEG_ALERT
      real(r8), parameter :: limval=0.0_r8
#endif

#ifdef N15_CHECKS_BIOTOY2
      real(r8) :: d15N_phyto
      real(r8) :: d15N_phyto_old
      real(r8) :: d15N_phyto_change
      real(r8) :: d15N_DON
      real(r8) :: d15N_DON_old

!      real(r8), parameter :: Rstd = 1.0_r8
#endif
#ifdef CHECK_SINK_MBAL
      real(r8) :: sum_PON_vert
      real(r8) :: sum_PON15_vert
      real(r8) :: sum_PON14_vert
#endif
#include "set_bounds.h"
!
!-----------------------------------------------------------------------
!  Add biological Source/Sink terms.
!-----------------------------------------------------------------------
!
!  Avoid computing source/sink terms if no biological iterations.
!
      IF (BioIter(ng).le.0) RETURN
!
!  Set time-stepping size (days) according to the number of iterations.
!
      dtdays=dt(ng)*sec2day/REAL(BioIter(ng),r8)
!
!  Set vertical sinking indentification vector.
!
      idsink(1)=iPON_                 ! particulate organic nitrogen
      idsink(2)=iopal                 ! particulate organic silica
#if defined N15
# if defined SINK_RATIO
      idsink(3)=iPONratio             ! 15PON/14PON
# else 
      idsink(3)=iPON15_               ! particulate organic 15 nitrogen
      idsink(4)=iPON14_               ! particulate organic 14 nitrogen
# endif
#endif
#if defined CARB & ! defined KO_CARB_SINK
      idsink(4)=iCalC                 ! carbon detritus
#endif

!
!  Set vertical sinking velocity vector in the same order as the
!  identification vector, IDSINK.
!
      Wbio(1)=setVPON(ng)             ! particulate organic nitrogen
      Wbio(2)=setVOpal(ng)            ! particulate organic silica
#if defined N15
# if defined SINK_RATIO
      Wbio(3)=setVPONratio(ng)       ! 15PON/14PON 
# else
      Wbio(3)=setVPON15(ng)           ! particulate organic 15 nitrogen
      Wbio(4)=setVPON14(ng)           ! particulate organic 14 nitrogen
# endif
#endif

#if defined CARB & ! defined KO_CARB_SINK
      Wbio(4)=setVCalC(ng)                 ! carbon detritus
#endif

!
!  Compute inverse thickness to avoid repeated divisions.
!
      J_LOOP : DO j=Jstr,Jend
        DO k=1,N(ng)
          DO i=Istr,Iend
            Hz_inv(i,k)=1.0_r8/Hz(i,j,k)
          END DO
        END DO
        DO k=1,N(ng)-1
          DO i=Istr,Iend
            Hz_inv2(i,k)=1.0_r8/(Hz(i,j,k)+Hz(i,j,k+1))
          END DO
        END DO
        DO k=2,N(ng)-1
          DO i=Istr,Iend
            Hz_inv3(i,k)=1.0_r8/(Hz(i,j,k-1)+Hz(i,j,k)+Hz(i,j,k+1))
          END DO
        END DO

! Check d15N valus of PON
#ifdef N15_CHECKS_BIOTOY
        DO k=1,N(ng)
          DO i=Istr,Iend

# ifdef MASKING
            IF (rmask(i,j).EQ.1) THEN
# endif
             IF ((k.EQ.29) .AND. (i.EQ.3) .AND. (j.EQ.3)) THEN
               d15N=(((t(i,j,k,nstp,iPON15_)/                       &
     &              t(i,j,k,nstp,iPON14_))/Rstd)-1)*1000
               print *, "before nemuro d15N PON=", d15N
               d15N_old=d15N
             ENDIF
# ifdef MASKING
            ENDIF
# endif
          END DO
        END DO
#endif

!  Extract biological variables from tracer arrays, place them into
!  scratch arrays, and restrict their values to be positive definite.
!  At input, all tracers (index nnew) from predictor step have
!  transport units (m Tunits) since we do not have yet the new
!  values for zeta and Hz. These are known after the 2D barotropic
!  time-stepping.
!

#ifdef N15_LIM
        DO k=1,N(ng)
          DO i=Istr,Iend
# ifdef MASKING
            IF (rmask(i,j).EQ.1) THEN
# endif
!NO315and14  
              IF ((t(i,j,k,nstp,iNO315_).LT.0.0_r8) .OR.             &
     &        (t(i,j,k,nstp,iNO314_).LT.0.0_r8)) THEN	     
                IF (t(i,j,k,nstp,iNO3_).GT.0.0_r8) THEN  
                  t(i,j,k,nstp,iNO315_)=((t_d15N+1000.0_r8)*         &
     &                                  t(i,j,k,nstp,iNO3_)*Rstd)/   &
     &                                  ((t_d15N+1000.0_r8)*Rstd+1000.0_r8)
                  t(i,j,k,nstp,iNO314_)=t(i,j,k,nstp,iNO3_)-        &
     &                                  t(i,j,k,nstp,iNO315_)
                ENDIF
              ENDIF
!NO3          
              IF (t(i,j,k,nstp,iNO3_).LT.1.0e-6_r8) THEN  
                t(i,j,k,nstp,iNO3_)=1.0e-6_r8
                t(i,j,k,nstp,iNO315_)=((t_d15N+1000.0_r8)*          &
     &                                t(i,j,k,nstp,iNO3_)*Rstd)/    &
     &                                ((t_d15N+1000.0_r8)*Rstd+1000.0_r8)
                t(i,j,k,nstp,iNO314_)=t(i,j,k,nstp,iNO3_)-          &
     &                                t(i,j,k,nstp,iNO315_)
              ENDIF
!NO3 hard d15N limit
              d15N=(((t(i,j,k,nstp,iNO315_)/                       &
     &             t(i,j,k,nstp,iNO314_))/Rstd)-1)*1000
              IF (d15N.LT.min_d15N) THEN
                t(i,j,k,nstp,iNO315_)=((low_d15N+1000.0_r8)*              &
     &                                t(i,j,k,nstp,iNO3_)*Rstd)/           &
     &                                ((low_d15N+1000.0_r8)*Rstd+1000.0_r8)
                t(i,j,k,nstp,iNO314_)=t(i,j,k,nstp,iNO3_)-                &
     &                                t(i,j,k,nstp,iNO315_)
              ENDIF
              IF (d15N.GT.max_d15N) THEN
                t(i,j,k,nstp,iNO315_)=((high_d15N+1000.0_r8)*              &
     &                                t(i,j,k,nstp,iNO3_)*Rstd)/           &
     &                                ((high_d15N+1000.0_r8)*Rstd+1000.0_r8)
                t(i,j,k,nstp,iNO314_)=t(i,j,k,nstp,iNO3_)-                &
     &                                t(i,j,k,nstp,iNO315_)
              ENDIF
!NH415and14     
              IF ((t(i,j,k,nstp,iNH415_).LT.0.0_r8) .OR.             &
     &        (t(i,j,k,nstp,iNH414_).LT.0.0_r8)) THEN
